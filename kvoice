#!/usr/bin/env bash
# Voice-to-Text Toggle Script for KDE (Wayland)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCKFILE="$SCRIPT_DIR/kvoice.lock"
AUDIO_FILE="$SCRIPT_DIR/kvoice.wav"
PYTHON_VENV="$SCRIPT_DIR/.venv/bin/python3"

# Cleanup at startup if lockfile is stale (process not running)
if [ -f "$LOCKFILE" ]; then
    PID=$(cat "$LOCKFILE")
    if ! ps -p "$PID" > /dev/null 2>&1; then
        echo "Removing stale lockfile and temporary audio."
        rm -f "$LOCKFILE" "$AUDIO_FILE"
    fi
fi

if [ ! -f "$LOCKFILE" ]; then
    # Auto-delete old audio before starting new recording
    rm -f "$AUDIO_FILE"
    
    notify-send "Recording started..." "Speak now..."
    touch "$LOCKFILE"
    ffmpeg -y -f pulse -i default -t 300 "$AUDIO_FILE" > "$SCRIPT_DIR/ffmpeg.log" 2>&1 &
    FFMPEG_PID=$!
    echo $FFMPEG_PID > "$LOCKFILE"
else
    FFMPEG_PID=$(cat "$LOCKFILE")
    kill $FFMPEG_PID
    rm -f "$LOCKFILE"
    notify-send "Recording stopped." "Transcribing..."
    
    if [ -f "$PYTHON_VENV" ]; then
        "$PYTHON_VENV" "$SCRIPT_DIR/transcribe.py" "$AUDIO_FILE"
    else
        python3 "$SCRIPT_DIR/transcribe.py" "$AUDIO_FILE"
    fi
fi
